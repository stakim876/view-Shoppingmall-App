# API base URL — 반드시 백엔드 backend/.env 의 PORT 와 맞출 것 (예: PORT=3102 이면 http://localhost:3102/api)
VITE_API_URL=http://localhost:3102/api

# Cloudflare Turnstile site key (optional)
VITE_TURNSTILE_SITE_KEY=

# Existing values
VITE_PORTONE_STORE_ID=impXXXXXXXX

# 카카오톡 채널 1:1 채팅 (https://pf.kakao.com/_채널ID/chat 형식)
# 1) https://business.kakao.com 접속 → 채널 선택 → 채널 관리자센터
# 2) 채널 홈 공개 URL 확인 (pf.kakao.com/_xxxxxxxxxx)
# 3) 끝에 /chat 붙인 주소를 넣기. 예: https://pf.kakao.com/_AbCdEf/chat
VITE_KAKAO_CHAT_URL=https://center-pf.kakao.com/
