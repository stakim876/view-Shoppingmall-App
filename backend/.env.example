# Database Configuration
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=myshop
DB_PORT=3306

# Server Configuration
PORT=3001

# CORS Configuration
CORS_ORIGIN=http://localhost:5173

# Cafe24 API Configuration (상품은 카페24에서 등록 → 이 홈페이지에 표시)
# CAFE24_MALL_ID + CAFE24_ACCESS_TOKEN 이 있으면 상품 목록/상세를 카페24 API에서 가져옵니다.
CAFE24_MALL_ID=your_mall_id
CAFE24_CLIENT_ID=your_client_id
CAFE24_CLIENT_SECRET=your_client_secret
CAFE24_ACCESS_TOKEN=your_access_token
CAFE24_API_URL=https://your-mall.cafe24api.com
