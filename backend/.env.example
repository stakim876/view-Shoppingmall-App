DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=myshop
DB_PORT=3306
# PlanetScale / Railway MySQL 등 TLS 필요 시: DB_SSL=true
# 인증서 검증 오류 시에만(비권장): DB_SSL_REJECT_UNAUTHORIZED=false
DB_SSL=
DB_SSL_REJECT_UNAUTHORIZED=

# 로컬: 3102 등. Render/Vercel 등 PaaS는 보통 PORT를 자동 주입 — 설정하지 않아도 됨.
PORT=3102
JWT_SECRET=replace_with_strong_random_secret
JWT_EXPIRES_IN=7d
ADMIN_INVITE_CODE=replace_with_admin_invite_code

# (선택) Railway 등: 서버 기동 시 이 이메일의 비밀번호를 DB에 직접 반영하고 role=admin.
# 로그인 확인 후 반드시 Variables에서 제거하세요.
# ADMIN_BOOTSTRAP_EMAIL=admin@example.com
# ADMIN_BOOTSTRAP_PASSWORD=AtLeast8Chars
# ADMIN_BOOTSTRAP_NAME=관리자

# 프로덕션: Vercel 프론트 주소(쉼표로 여러 개). 예: https://my-shop.vercel.app
# 비우면 localhost 출처만 허용
CORS_ORIGIN=

# 메일 링크·재입고 알림용 프론트 URL (프로덕션에서는 Vercel 도메인)
CLIENT_BASE_URL=http://localhost:5173

# 주문 배송 정책(원 단위)
FREE_SHIPPING_MIN=30000
SHIPPING_FEE=3000

MAX_LOGIN_ATTEMPTS=5
LOGIN_ATTEMPT_WINDOW_MS=900000
LOGIN_LOCKOUT_MS=900000
LOGIN_CAPTCHA_THRESHOLD=3
PASSWORD_RESET_TOKEN_TTL_MS=1800000

TURNSTILE_SECRET_KEY=

# AI 큐레이터·챗봇 (없으면 규칙 기반 fallback)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-3.5-turbo

# (선택) Elasticsearch — 설정 시 검색에 ES 사용, 미설정 시 MySQL 관련도 검색
# ELASTICSEARCH_URL=http://localhost:9200

# (선택) CRM 세그먼트 기준 (원)
# CRM_VIP_MIN_SPENT=500000
# CRM_ACTIVE_DAYS=30
# CRM_NEW_DAYS=14
# CRM_DORMANT_DAYS=90

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

