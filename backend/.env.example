# Database Configuration
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=myshop
DB_PORT=3306

# Server Configuration
# 프론트 client/.env 의 VITE_API_URL 은 http://localhost:<PORT>/api 형식으로 이 값과 일치해야 합니다.
PORT=3102
JWT_SECRET=replace_with_strong_random_secret
JWT_EXPIRES_IN=7d
ADMIN_INVITE_CODE=replace_with_admin_invite_code

# CORS Configuration
# 로컬 개발에서는 비워두면 localhost 모든 포트를 허용합니다.
# 배포 시에는 반드시 실제 도메인(들)을 쉼표로 지정하세요.
CORS_ORIGIN=

# Frontend Base URL for reset links
CLIENT_BASE_URL=http://localhost:5173

# Login security
MAX_LOGIN_ATTEMPTS=5
LOGIN_ATTEMPT_WINDOW_MS=900000
LOGIN_LOCKOUT_MS=900000
LOGIN_CAPTCHA_THRESHOLD=3
PASSWORD_RESET_TOKEN_TTL_MS=1800000

# CAPTCHA (choose one provider)
TURNSTILE_SECRET_KEY=
# RECAPTCHA_SECRET_KEY=

# SMTP (optional, fallback logs reset link if missing)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

